generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  // Baris 'url' DIHAPUS dari sini
}

// Tabel untuk menampung ucapan & doa
model Wish {
  id         Int      @id @default(autoincrement())
  clientName String
  name       String
  attendance String
  message    String   @db.Text
  createdAt  DateTime @default(now())
}